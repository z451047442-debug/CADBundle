#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)

STRINGTABLE
BEGIN
    IDS_LIBDESCRIPTION  "CAD 注释工具集"
    IDS_CATEGORY        "CAD Tools"
    IDS_UTILITY_CLASS   "CADAnnotatePanel"
    IDS_DIM_CLASS       "CADDimension"
    IDS_TEXT_CLASS      "CADText"
    IDS_LEADER_CLASS    "CADLeader"
    IDS_TABLE_CLASS     "CADTable"
    IDS_PANEL_TITLE     "CAD 注释"
    IDS_BTN_DIM         "标注（三点）"
    IDS_BTN_TEXT        "文字（单击放置）"
    IDS_BTN_LEADER      "引线（三点）"
    IDS_BTN_TABLE       "表格（单击插入）"
    IDS_DESC_DIM        "起点、终点、尺寸线位置"
    IDS_DESC_TEXT       "单击放置文字"
    IDS_DESC_LEADER     "起点、拐点、文本位置"
    IDS_DESC_TABLE      "单击插入表格"
    IDS_STATUS_READY    "状态：就绪"
    IDS_STATUS_CREATING "正在创建：%s"
    IDS_STATUS_DONE     "已结束创建；若已创建，可在修改面板调整参数"
    IDS_STATUS_ABORTED  "已取消创建"
    IDS_STATUS_ERROR    "创建失败"
    IDS_PARAMS          "参数"
    IDS_TABLE_EDIT      "编辑单元格..."
    IDS_FONT_FALLBACK   "字体不可用，已回退"
    IDS_DEFAULT_TEXT    "文字"
    IDS_DEFAULT_NOTE    "注释"
    IDS_ERR_CREATE      "无法进入创建模式"
    IDS_ERR_FONT        "字体不可用"
    IDS_ERR_TABLE       "表格操作失败"
    IDS_ACCEPT          "确定"
    IDS_CANCEL          "取消"
    IDS_CLOSE           "关闭"
    IDS_DIM_P0          "起点"
    IDS_DIM_P1          "终点"
    IDS_DIM_P2          "尺寸线参考点"
    IDS_DIM_SHOWXYZ     "显示坐标"
    IDS_DIM_ARROW       "箭头大小"
    IDS_DIM_TEXTH       "文字高度"
    IDS_DIM_EXTOFF      "延伸线超出"
    IDS_DIM_LINECOL     "线条颜色"
    IDS_DIM_TEXTCOL     "文字颜色"
    IDS_DIM_PREC        "小数位数"
    IDS_TEXT_POS        "文字位置"
    IDS_TEXT_STRING     "文字内容"
    IDS_TEXT_SIZE       "文字高度"
    IDS_TEXT_FONT       "字体名称"
    IDS_TEXT_COLOR      "文字颜色"
END

IDD_CAD_PANEL DIALOGEX 0, 0, 240, 160
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "CAD 注释"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    PUSHBUTTON      "标注（三点）", IDC_PANEL_BTN_DIM, 10, 10, 110, 18
    LTEXT           "起点、终点、尺寸线位置", IDC_PANEL_DESC_DIM, 128, 14, 100, 12
    PUSHBUTTON      "文字（单击放置）", IDC_PANEL_BTN_TEXT, 10, 34, 110, 18
    LTEXT           "单击放置文字", IDC_PANEL_DESC_TEXT, 128, 38, 100, 12
    PUSHBUTTON      "引线（三点）", IDC_PANEL_BTN_LEADER, 10, 58, 110, 18
    LTEXT           "起点、拐点、文本位置", IDC_PANEL_DESC_LEADER, 128, 62, 100, 12
    PUSHBUTTON      "表格（单击插入）", IDC_PANEL_BTN_TABLE, 10, 82, 110, 18
    LTEXT           "单击插入表格", IDC_PANEL_DESC_TABLE, 128, 86, 100, 12
    LTEXT           "状态：就绪", IDC_PANEL_STATUS, 10, 116, 160, 12
    DEFPUSHBUTTON   "关闭", IDC_PANEL_CLOSE, 180, 112, 50, 18
END

IDD_CAD_DIM DIALOGEX 0, 0, 230, 238
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
CAPTION "CADDimension"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "P0 X", IDC_STATIC, 6, 6, 42, 8
    CONTROL         "", IDC_DIM_P0X, "CustEdit", WS_TABSTOP, 50, 4, 34, 10
    CONTROL         "", IDC_DIM_P0XSPIN, "SpinnerControl", 0x0, 85, 4, 7, 10
    LTEXT           "Y", IDC_STATIC, 96, 6, 8, 8
    CONTROL         "", IDC_DIM_P0Y, "CustEdit", WS_TABSTOP, 104, 4, 34, 10
    CONTROL         "", IDC_DIM_P0YSPIN, "SpinnerControl", 0x0, 139, 4, 7, 10
    LTEXT           "Z", IDC_STATIC, 150, 6, 8, 8
    CONTROL         "", IDC_DIM_P0Z, "CustEdit", WS_TABSTOP, 158, 4, 34, 10
    CONTROL         "", IDC_DIM_P0ZSPIN, "SpinnerControl", 0x0, 193, 4, 7, 10

    LTEXT           "P1 X", IDC_STATIC, 6, 20, 42, 8
    CONTROL         "", IDC_DIM_P1X, "CustEdit", WS_TABSTOP, 50, 18, 34, 10
    CONTROL         "", IDC_DIM_P1XSPIN, "SpinnerControl", 0x0, 85, 18, 7, 10
    LTEXT           "Y", IDC_STATIC, 96, 20, 8, 8
    CONTROL         "", IDC_DIM_P1Y, "CustEdit", WS_TABSTOP, 104, 18, 34, 10
    CONTROL         "", IDC_DIM_P1YSPIN, "SpinnerControl", 0x0, 139, 18, 7, 10
    LTEXT           "Z", IDC_STATIC, 150, 20, 8, 8
    CONTROL         "", IDC_DIM_P1Z, "CustEdit", WS_TABSTOP, 158, 18, 34, 10
    CONTROL         "", IDC_DIM_P1ZSPIN, "SpinnerControl", 0x0, 193, 18, 7, 10

    LTEXT           "P2 X", IDC_STATIC, 6, 34, 42, 8
    CONTROL         "", IDC_DIM_P2X, "CustEdit", WS_TABSTOP, 50, 32, 34, 10
    CONTROL         "", IDC_DIM_P2XSPIN, "SpinnerControl", 0x0, 85, 32, 7, 10
    LTEXT           "Y", IDC_STATIC, 96, 34, 8, 8
    CONTROL         "", IDC_DIM_P2Y, "CustEdit", WS_TABSTOP, 104, 32, 34, 10
    CONTROL         "", IDC_DIM_P2YSPIN, "SpinnerControl", 0x0, 139, 32, 7, 10
    LTEXT           "Z", IDC_STATIC, 150, 34, 8, 8
    CONTROL         "", IDC_DIM_P2Z, "CustEdit", WS_TABSTOP, 158, 32, 34, 10
    CONTROL         "", IDC_DIM_P2ZSPIN, "SpinnerControl", 0x0, 193, 32, 7, 10

    CONTROL         "显示 P0/P1/P2 坐标", IDC_DIM_SHOWXYZ, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 50, 150, 10
    LTEXT           "箭头大小（屏幕）", IDC_STATIC, 6, 68, 60, 8
    CONTROL         "", IDC_DIM_ARROW, "CustEdit", WS_TABSTOP, 70, 66, 34, 10
    CONTROL         "", IDC_DIM_ARROWSPIN, "SpinnerControl", 0x0, 105, 66, 7, 10
    LTEXT           "文字高度（屏幕）", IDC_STATIC, 6, 82, 60, 8
    CONTROL         "", IDC_DIM_TEXTH, "CustEdit", WS_TABSTOP, 70, 80, 34, 10
    CONTROL         "", IDC_DIM_TEXTHSPIN, "SpinnerControl", 0x0, 105, 80, 7, 10
    LTEXT           "延伸线超出", IDC_STATIC, 6, 96, 60, 8
    CONTROL         "", IDC_DIM_EXTOFF, "CustEdit", WS_TABSTOP, 70, 94, 34, 10
    CONTROL         "", IDC_DIM_EXTOFFSPIN, "SpinnerControl", 0x0, 105, 94, 7, 10
    LTEXT           "小数位数", IDC_STATIC, 6, 110, 60, 8
    CONTROL         "", IDC_DIM_PREC, "CustEdit", WS_TABSTOP, 70, 108, 34, 10
    CONTROL         "", IDC_DIM_PRECSPIN, "SpinnerControl", 0x0, 105, 108, 7, 10
    LTEXT           "线条颜色", IDC_STATIC, 6, 126, 60, 8
    CONTROL         "", IDC_DIM_LINECOL, "ColorSwatch", WS_TABSTOP, 70, 123, 50, 12
    LTEXT           "文字颜色", IDC_STATIC, 6, 142, 60, 8
    CONTROL         "", IDC_DIM_TEXTCOL, "ColorSwatch", WS_TABSTOP, 70, 139, 50, 12
END

IDD_CAD_TEXT DIALOGEX 0, 0, 230, 128
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
CAPTION "CADText"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "位置 X", IDC_STATIC, 6, 6, 42, 8
    CONTROL         "", IDC_TEXT_POSX, "CustEdit", WS_TABSTOP, 55, 4, 34, 10
    CONTROL         "", IDC_TEXT_POSXSPIN, "SpinnerControl", 0x0, 90, 4, 7, 10
    LTEXT           "Y", IDC_STATIC, 101, 6, 8, 8
    CONTROL         "", IDC_TEXT_POSY, "CustEdit", WS_TABSTOP, 109, 4, 34, 10
    CONTROL         "", IDC_TEXT_POSYSPIN, "SpinnerControl", 0x0, 144, 4, 7, 10
    LTEXT           "Z", IDC_STATIC, 155, 6, 8, 8
    CONTROL         "", IDC_TEXT_POSZ, "CustEdit", WS_TABSTOP, 163, 4, 34, 10
    CONTROL         "", IDC_TEXT_POSZSPIN, "SpinnerControl", 0x0, 198, 4, 7, 10

    LTEXT           "文字", IDC_STATIC, 6, 54, 42, 8
    CONTROL         "", IDC_TEXT_STRING, "CustEdit", WS_TABSTOP, 55, 52, 165, 12
    LTEXT           "高度", IDC_STATIC, 6, 72, 42, 8
    CONTROL         "", IDC_TEXT_SIZE, "CustEdit", WS_TABSTOP, 55, 70, 34, 10
    CONTROL         "", IDC_TEXT_SIZESPIN, "SpinnerControl", 0x0, 90, 70, 7, 10
    LTEXT           "字体", IDC_STATIC, 6, 90, 42, 8
    CONTROL         "", IDC_TEXT_FONT, "CustEdit", WS_TABSTOP, 55, 88, 165, 12
    LTEXT           "颜色", IDC_STATIC, 6, 108, 42, 8
    CONTROL         "", IDC_TEXT_COLOR, "ColorSwatch", WS_TABSTOP, 55, 105, 50, 12
END
