IDD_CAD_TABLE_EDITOR DIALOGEX 0, 0, 360, 278
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑表格单元格"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL         "", IDC_TABLE_EDIT_LIST, "SysListView32", 0x00800005, 6, 6, 348, 188
    LTEXT           "单元格", IDC_STATIC, 6, 202, 42, 8
    EDITTEXT        IDC_TABLE_EDIT_CELL, 55, 200, 260, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "应用单元格/行列", IDC_TABLE_EDIT_APPLY, 320, 199, 34, 14
    LTEXT           "行", IDC_STATIC, 6, 220, 14, 8
    EDITTEXT        IDC_TABLE_EDIT_ROWS, 22, 218, 34, 12, ES_NUMBER
    CONTROL         "", IDC_TABLE_EDIT_ROWSSPIN, "msctls_updown32", 0x10000016, 56, 218, 9, 12
    LTEXT           "列", IDC_STATIC, 82, 220, 14, 8
    EDITTEXT        IDC_TABLE_EDIT_COLS, 98, 218, 34, 12, ES_NUMBER
    CONTROL         "", IDC_TABLE_EDIT_COLSSPIN, "msctls_updown32", 0x10000016, 132, 218, 9, 12
    LTEXT           "状态：就绪", IDC_TABLE_EDIT_STATUS, 6, 244, 340, 10
    DEFPUSHBUTTON   "确定", IDOK, 220, 258, 60, 16
    PUSHBUTTON      "取消", IDC_TABLE_EDIT_CANCEL, 290, 258, 60, 16
END
